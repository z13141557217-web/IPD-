# 复制为 .env 并填入真实值；.env 不会被提交到 git。

# 数据库密码，自己设一个。密码里请只用字母和数字。
POSTGRES_PASSWORD=

# 浏览器访问的端口
APP_PORT=8080

# ---- 大模型 ----
# 这几项也可以不在这里填，启动后在界面的“设置”页里填写。设置页保存过之后，以设置页的为准。
# mock              演示模式，不调用任何模型（默认）
# openai_compatible 调用兼容 OpenAI Chat Completions 接口的服务
LLM_PROVIDER=mock

# 以下三项在 LLM_PROVIDER=openai_compatible 时填写。
# LLM_BASE_URL 填服务商文档里的 base_url（有的以 /v1 结尾，有的不要），程序会在后面加 /chat/completions；
# 本地推理服务没有密钥时 LLM_API_KEY 可以留空。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
